<!-- SpotBugs 豁免清单：只为"无法通过修改代码消除"的现存问题建立豁免台账，逐条注明原因与消除计划，随修复逐条删除 -->
<FindBugsFilter>

    <!-- ==================== 合理豁免（设计使然） ==================== -->
    <!-- data-mf 与 data-mp 是平行实现，二者均与各自 ORM 基类的简单名同名，属有意设计 -->
    <Match>
        <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS"/>
        <Class name="top.continew.starter.data.service.impl.ServiceImpl"/>
    </Match>
</FindBugsFilter>
