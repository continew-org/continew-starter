                <sonar.issue.ignore.multicriteria.S2176-serviceimpl.resourceKey>**/data/service/impl/ServiceImpl.java</sonar.issue.ignore.multicriteria.S2176-serviceimpl.resourceKey>
                <!--
                    S6204：TreeUtils/ReflectUtils/LocalStorageStrategy 保持返回可变列表的既有契约，Stream.toList() 会破坏契约，故按文件排除。
                -->
                <sonar.issue.ignore.multicriteria.S6204-tree.ruleKey>java:S6204</sonar.issue.ignore.multicriteria.S6204-tree.ruleKey>
                <sonar.issue.ignore.multicriteria.S6204-tree.resourceKey>**/core/util/TreeUtils.java</sonar.issue.ignore.multicriteria.S6204-tree.resourceKey>
                <sonar.issue.ignore.multicriteria.S6204-reflect.ruleKey>java:S6204</sonar.issue.ignore.multicriteria.S6204-reflect.ruleKey>
                <sonar.issue.ignore.multicriteria.S6204-reflect.resourceKey>**/core/util/ReflectUtils.java</sonar.issue.ignore.multicriteria.S6204-reflect.resourceKey>
                <sonar.issue.ignore.multicriteria.S6204-storage.ruleKey>java:S6204</sonar.issue.ignore.multicriteria.S6204-storage.ruleKey>
                <sonar.issue.ignore.multicriteria.S6204-storage.resourceKey>**/storage/strategy/impl/LocalStorageStrategy.java</sonar.issue.ignore.multicriteria.S6204-storage.resourceKey>
                <!--
                    S9149：TreeUtils.build / ServletUtils.isMultipart 与上游 TreeUtil、JakartaServletUtil 同名，属刻意保留的门面方法，故按文件排除。
                -->
                <sonar.issue.ignore.multicriteria.S9149-tree.ruleKey>java:S9149</sonar.issue.ignore.multicriteria.S9149-tree.ruleKey>
                <sonar.issue.ignore.multicriteria.S9149-tree.resourceKey>**/core/util/TreeUtils.java</sonar.issue.ignore.multicriteria.S9149-tree.resourceKey>
                <sonar.issue.ignore.multicriteria.S9149-servlet.ruleKey>java:S9149</sonar.issue.ignore.multicriteria.S9149-servlet.ruleKey>
                <sonar.issue.ignore.multicriteria.S9149-servlet.resourceKey>**/core/util/ServletUtils.java</sonar.issue.ignore.multicriteria.S9149-servlet.resourceKey>
                <!--
                    S3077：ProgressAwareMultipartFile 的字段访问受 progressLock 保护，CustomLicenseManager 为带参惰性单例，故按文件排除。
                -->
                <sonar.issue.ignore.multicriteria.S3077-progress.ruleKey>java:S3077</sonar.issue.ignore.multicriteria.S3077-progress.ruleKey>
                <sonar.issue.ignore.multicriteria.S3077-progress.resourceKey>**/storage/domain/file/ProgressAwareMultipartFile.java</sonar.issue.ignore.multicriteria.S3077-progress.resourceKey>
                <sonar.issue.ignore.multicriteria.S3077-license.ruleKey>java:S3077</sonar.issue.ignore.multicriteria.S3077-license.ruleKey>
                <sonar.issue.ignore.multicriteria.S3077-license.resourceKey>**/license/manager/CustomLicenseManager.java</sonar.issue.ignore.multicriteria.S3077-license.resourceKey>
                <!--
                    S5738：SpringUtils.registerResourceHandler 刻意使用带 UrlPathHelper 的废弃构造器，
                    不传 pathHelper 时框架侧 PathResourceResolver 会改变相对路径的解码/编码判定，
                    与既有资源映射行为相反（文件名含 % 时可能 404）；显式传 mvcUrlPathHelper
                    保持行为不变，随 Spring 移除该构造器时一并迁移，故按文件排除。
