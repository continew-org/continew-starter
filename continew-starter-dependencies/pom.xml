                <sonar.issue.ignore.multicriteria.S5738-springutils.ruleKey>java:S5738</sonar.issue.ignore.multicriteria.S5738-springutils.ruleKey>
                <sonar.issue.ignore.multicriteria.S5738-springutils.resourceKey>**/core/util/SpringUtils.java</sonar.issue.ignore.multicriteria.S5738-springutils.resourceKey>
