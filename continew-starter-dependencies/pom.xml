                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Sonar 代码质量分析 -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.host.url>https://sonarcloud.io</sonar.host.url>
                <sonar.organization>continew-org</sonar.organization>
                <sonar.projectKey>continew-org_continew-starter</sonar.projectKey>
                <sonar.moduleKey>${project.groupId}:${project.artifactId}</sonar.moduleKey>
                <!--
                    S3252：项目统一使用 Hutool 门面类 StrUtil/ValidateUtil/URLEncodeUtil 等调用静态方法，
                    其父类 CharSequenceUtil/Validator/URLEncodeUtil 属实现细节，经门面访问是 Hutool 官方推荐用法，故关闭该规则。
                -->
                <sonar.issue.ignore.multicriteria>S3252,S2143-excel,S2143-license,S2143-license-param,S2143-license-param-vo,S2143-license-manager,S2143-date-converter,S2176-iservice,S2176-serviceimpl,S6204-tree,S6204-reflect,S6204-storage,S9149-tree,S9149-servlet,S3077-progress,S3077-license,S5738-springutils</sonar.issue.ignore.multicriteria>
                <sonar.issue.ignore.multicriteria.S3252.ruleKey>java:S3252</sonar.issue.ignore.multicriteria.S3252.ruleKey>
                <sonar.issue.ignore.multicriteria.S3252.resourceKey>**/*</sonar.issue.ignore.multicriteria.S3252.resourceKey>
                <!--
                    S2143：ExcelUtils/LicenseCreateService 中的 java.util.Date 为外部 API 强制的边界类型，
                    无法整体迁移 java.time（前者兼容 Excel 实体字段类型与单元格数据，后者由 truelicense
                    LicenseContent API 定义签发/过期时间）；该规则上报文件级 issue，@SuppressWarnings 不生效，故按文件排除。
                -->
                <sonar.issue.ignore.multicriteria.S2143-excel.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.S2143-excel.ruleKey>
                <sonar.issue.ignore.multicriteria.S2143-excel.resourceKey>**/excel/util/ExcelUtils.java</sonar.issue.ignore.multicriteria.S2143-excel.resourceKey>
                <sonar.issue.ignore.multicriteria.S2143-license.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.S2143-license.ruleKey>
                <sonar.issue.ignore.multicriteria.S2143-license.resourceKey>**/license/service/LicenseCreateService.java</sonar.issue.ignore.multicriteria.S2143-license.resourceKey>
                <!--
                    S2143：LicenseCreatorParam/LicenseCreatorParamVO 与 ServerLicenseManager 同属 truelicense LicenseContent 边界，
                    与 LicenseCreateService 同等处理。
                -->
                <sonar.issue.ignore.multicriteria.S2143-license-param.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.S2143-license-param.ruleKey>
                <sonar.issue.ignore.multicriteria.S2143-license-param.resourceKey>**/license/model/LicenseCreatorParam.java</sonar.issue.ignore.multicriteria.S2143-license-param.resourceKey>
                <sonar.issue.ignore.multicriteria.S2143-license-param-vo.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.S2143-license-param-vo.ruleKey>
                <sonar.issue.ignore.multicriteria.S2143-license-param-vo.resourceKey>**/license/model/LicenseCreatorParamVO.java</sonar.issue.ignore.multicriteria.S2143-license-param-vo.resourceKey>
                <sonar.issue.ignore.multicriteria.S2143-license-manager.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.S2143-license-manager.ruleKey>
                <sonar.issue.ignore.multicriteria.S2143-license-manager.resourceKey>**/license/manager/ServerLicenseManager.java</sonar.issue.ignore.multicriteria.S2143-license-manager.resourceKey>
                <!--
                    S2143：DateConverter 的职责就是把字符串转换为 java.util.Date（Spring MVC 对 Date 参数的转换器），
                    改用 java.time 会改变该转换器的语义，故排除。
                -->
                <sonar.issue.ignore.multicriteria.S2143-date-converter.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.S2143-date-converter.ruleKey>
                <sonar.issue.ignore.multicriteria.S2143-date-converter.resourceKey>**/web/autoconfigure/mvc/converter/time/DateConverter.java</sonar.issue.ignore.multicriteria.S2143-date-converter.resourceKey>
                <!--
                    S2176：data-mf 的 IService/ServiceImpl 刻意镜像 MyBatis-Flex 同名 API，重命名会破坏公开 API，故按文件排除。
                -->
                <sonar.issue.ignore.multicriteria.S2176-iservice.ruleKey>java:S2176</sonar.issue.ignore.multicriteria.S2176-iservice.ruleKey>
                <sonar.issue.ignore.multicriteria.S2176-iservice.resourceKey>**/data/service/IService.java</sonar.issue.ignore.multicriteria.S2176-iservice.resourceKey>
