<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.continew.starter</groupId>
        <artifactId>continew-starter</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>continew-starter-smoke-tests</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>ContiNew Starter 消费方冒烟测试模块（仅测试用途，不发布）</description>

    <properties>
        <!-- 仅测试用途模块：跳过 deploy，发布侧另有 release profile 的 excludeArtifacts 双保险 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- 冒烟的本意是显式组合：即使存在传递覆盖，三个 Starter 也必须逐个声明 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-json-jackson</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 组合矩阵：cache + auth -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-cache-redisson</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-auth-satoken</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 组合矩阵：data + extension -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-data-mp</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-extension-tenant-mp</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-extension-datapermission-mp</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 组合矩阵：encrypt + web -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-encrypt-field</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 组合矩阵：log + trace -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-log-aop</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-trace</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 组合矩阵：messaging + storage -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-messaging-mail</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-messaging-websocket</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-storage</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- TestRestTemplate 所在构件（Spring Boot 4 模块化拆分，包名 org.springframework.boot.resttestclient） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- RestTemplateBuilder 所在构件（TestRestTemplateTestAutoConfiguration 依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- spring-boot-micrometer-tracing-brave 的 POM 不传递引入 Brave 桥，不显式声明时 Tracer 恒为 NOOP -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
