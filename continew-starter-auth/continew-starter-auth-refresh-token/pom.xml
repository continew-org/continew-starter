<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.continew.starter</groupId>
        <artifactId>continew-starter-auth</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>continew-starter-auth-refresh-token</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>ContiNew Starter 认证模块 - Refresh Token（可轮换的登录会话管理）</description>

    <dependencies>
        <!-- 缓存模块 - Redisson（Refresh Session 存储、轮换快照与刷新限流的必要依赖） -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-cache-redisson</artifactId>
        </dependency>

        <!-- 消息模块 - WebSocket（登录会话撤销后实时关闭对应连接） -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-messaging-websocket</artifactId>
        </dependency>

        <!-- Sa-Token（轻量级 Java 权限认证框架，让鉴权变得简单、优雅） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Sa-Token 整合 JWT（Access Token 的 sid 会话声明依赖 JWT 扩展参数能力） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
        </dependency>

        <!-- Spring Web（Refresh Token Cookie 写入、请求来源校验与 Servlet 上下文） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring AOP（认证策略写锁切面） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring 参数校验（配置属性启动期校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JetCache（Access Token 会话有效结论的本地缓存） -->
        <dependency>
            <groupId>com.alicp.jetcache</groupId>
            <artifactId>jetcache-core</artifactId>
        </dependency>

        <!-- Hutool（工具库） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-json</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
