<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.continew.starter</groupId>
        <artifactId>continew-starter-messaging</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>continew-starter-messaging-mqtt</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>ContiNew Starter 消息模块 - MQTT</description>

    <dependencies>
        <!-- Spring MQTT 消息模块 -->
        <dependency>
            <groupId>org.springframework.integration</groupId>
            <artifactId>spring-integration-mqtt</artifactId>
        </dependency>

        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试依赖 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-starter-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers HiveMQ 容器模块（MQTT 集成测试；版本经 Boot BOM 导入的 testcontainers-bom 统一供给） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-hivemq</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot Integration 自动配置（@EnableIntegration 驱动 @ServiceActivator/@MessagingGateway
             注解装配，IT 需要在真实 Boot 路径下激活出入站链路；版本经 Boot BOM 统一供给） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-integration</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
